<!DOCTYPE web-app PUBLIC
 "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
 "http://java.sun.com/dtd/web-app_2_3.dtd" >

<web-app>
	<display-name>Archetype Created Web Application</display-name>
	<servlet>
		<servlet-name>myds</servlet-name>
		<servlet-class>org.springframework.web.servlet.DispatcherServlet</servlet-class>
		<!-- shift+ctrl+t type dispatcherServlet then it will open that file and then it will give that package 
package org.springframework.web.servlet; -->
	</servlet>
	<servlet-mapping>
		<servlet-name>myds</servlet-name>
		<url-pattern></url-pattern>
		<!-- which url should go to do the dispatcher -->
	</servlet-mapping>
</web-app>
<!-- 👉 Because in Spring MVC, we don’t directly call servlets like:
@WebServlet("/Login")
Instead:
✅ One single servlet handles ALL requests
That servlet is:
👉 DispatcherServlet (this is the main controller of spring mvc)-->
